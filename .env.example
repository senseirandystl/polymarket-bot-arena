# Polymarket Bot Arena — docker-compose environment
# Copy to .env and edit before `docker compose up`:
#   cp .env.example .env
#
# Never commit .env (it is gitignored). Paper mode needs no API keys.

# ---------------------------------------------------------------------------
# Dashboard HTTP Basic auth
# ---------------------------------------------------------------------------
# REQUIRED change before exposing the dashboard beyond localhost.
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me-before-public-expose

# Host bind for the published port. Default 127.0.0.1 = local only.
# Set to 0.0.0.0 only behind a reverse proxy / firewall you control.
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8501

# ---------------------------------------------------------------------------
# Data directory (host path mounted at /data in both containers)
# ---------------------------------------------------------------------------
# Relative paths are resolved from the compose file directory.
PBA_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Timezone (ET day boundaries for dashboard "today" stats)
# ---------------------------------------------------------------------------
TZ=America/New_York

# ---------------------------------------------------------------------------
# Optional operational knobs (omit to use config.py defaults)
# ---------------------------------------------------------------------------
# ARENA_PAPER_BANKROLL=200
# ARENA_KELLY_FRACTION=0.25
# ARENA_TRADE_LOOP_INTERVAL_SEC=1.0
# ARENA_MARKET_DATA_INTERVAL_SEC=1.0
# ARENA_HTTP_MAX_RETRIES=2
# ARENA_LOG_JSON=0
# ARENA_LOG_STALE_SEC=300

# ---------------------------------------------------------------------------
# Desk Floor is frozen (legacy). Use Strategy Lab below — not the old Desk cycle.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Strategy Lab pipeline (active). Desk Floor / desk_* tables are legacy/orphan.
# PAPER_SLOTS=0 ⇒ invent/backtest only (no paper deploys).
# ---------------------------------------------------------------------------
# STRATEGY_LAB_ENABLED=1
# STRATEGY_LAB_CYCLE_INTERVAL_SEC=300
# STRATEGY_LAB_MAX_OPEN=8
# STRATEGY_LAB_MAX_NEW_PER_TICK=2
# STRATEGY_LAB_PAPER_SLOTS=0
# STRATEGY_LAB_AUTO_PROMOTE=0
# STRATEGY_LAB_BACKTEST_MIN_PNL=1.0
# STRATEGY_LAB_BACKTEST_MIN_TRADES=5
# STRATEGY_LAB_LLM_PROVIDER=none
# STRATEGY_LAB_PROMOTE_MIN_TRADES=100
# STRATEGY_LAB_PROMOTE_MIN_DAYS=7
# STRATEGY_LAB_PROMOTE_TRADE_FLOOR=30

# OLLAMA_HOST=http://127.0.0.1:11434
